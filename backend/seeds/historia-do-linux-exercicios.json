  {
    "key": "s09",
    "title": "Criar um script executável",
    "difficulty": "MEDIUM",
    "statement": "<p>Crie o arquivo <code>/labs/backup.sh</code> com a linha <code>#!/bin/bash</code> e deixe-o executável por todos (modo <code>755</code>).</p>",
    "hints": [
      {
        "text": "A primeira linha de um script diz qual interpretador o executa."
      },
      {
        "text": "chmod muda as permissões. O modo 755 dá leitura e execução a todos e escrita ao dono.",
        "command": "chmod 755 /labs/backup.sh"
      }
    ],
    "solution": {
      "summary": "",
      "steps": [
        {
          "command": "mkdir -p /labs"
        },
        {
          "command": "echo '#!/bin/bash' > /labs/backup.sh"
        },
        {
          "command": "chmod 755 /labs/backup.sh"
        }
      ]
    },
    "conditions": [
      {
        "kind": "DIR_EXISTS",
        "path": "/labs"
      },
      {
        "kind": "FILE_EXISTS",
        "path": "/labs/backup.sh"
      },
      {
        "kind": "FILE_CONTENT",
        "path": "/labs/backup.sh",
        "content": "#!/bin/bash\n",
        "match": "equals"
      },
      {
        "kind": "MODE",
        "path": "/labs/backup.sh",
        "mode": "755"
      }
    ],
    "dependsOn": null,
    "link": "practice"
  },
