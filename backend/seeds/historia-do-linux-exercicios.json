  {
    "key": "s03",
    "title": "Escrever uma palavra em um arquivo",
    "difficulty": "EASY",
    "statement": "<p>Crie o arquivo <code>/labs/linux.txt</code> contendo apenas a palavra <code>Linux</code>.</p>",
    "hints": [
      {
        "text": "O comando echo imprime um texto, e o símbolo > manda a saída para um arquivo."
      },
      {
        "text": "Lembre de criar o diretório antes.",
        "command": "echo Linux > /labs/linux.txt"
      }
    ],
    "solution": {
      "summary": "",
      "steps": [
        {
          "command": "mkdir -p /labs"
        },
        {
          "command": "echo Linux > /labs/linux.txt"
        }
      ]
    },
    "conditions": [
      {
        "kind": "DIR_EXISTS",
        "path": "/labs"
      },
      {
        "kind": "FILE_EXISTS",
