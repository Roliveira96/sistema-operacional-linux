  {
    "key": "s01",
    "title": "Criar um arquivo vazio",
    "difficulty": "EASY",
    "statement": "<p>Crie o arquivo vazio <code>/labs/vazio.txt</code>. O diretório <code>/labs</code> ainda não existe.</p>",
    "hints": [
      {
        "text": "O comando mkdir -p cria um diretório e os que faltam no caminho."
      },
      {
        "text": "O comando touch cria um arquivo vazio.",
        "command": "touch /labs/vazio.txt"
      }
    ],
    "solution": {
      "summary": "",
      "steps": [
        {
          "command": "mkdir -p /labs"
        },
        {
          "command": "touch /labs/vazio.txt"
        }
      ]
    },
    "conditions": [
      {
        "kind": "DIR_EXISTS",
        "path": "/labs"
      },
      {
        "kind": "FILE_EXISTS",
        "path": "/labs/vazio.txt"
      }
    ],
    "dependsOn": null,
    "link": "practice"
  },
