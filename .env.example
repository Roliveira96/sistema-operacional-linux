# Copy to .env and adjust. Never commit .env.
# Values below are for local development only.
# The development machine is reached by its LAN IP (192.168.3.111), not
# localhost, because the platform is used from other machines on the network.
# Replace it with your machine IP.

# --- Backend ---
APP_ENV=development
HTTP_ADDR=:8080
LOG_LEVEL=debug
SHUTDOWN_TIMEOUT=15s
# Next.js server address, trusted to forward the client IP (X-Forwarded-For)
HTTP_TRUSTED_PROXIES=192.168.3.111,127.0.0.1

# Authentication (SPEC-003). The initial password is only used the first
# time the admin account is created and must be changed at first login.
ADMIN_EMAIL=admin@rmo.dev.br
ADMIN_INITIAL_PASSWORD=change-me-on-first-login
# Public frontend address used in e-mail links
APP_PUBLIC_URL=http://192.168.3.111:3010

# PostgreSQL (DB_PORT is also the host port published by Docker Compose)
DB_HOST=192.168.3.111
DB_PORT=5440
DB_NAME=linux_lab
DB_USER=linux_lab
DB_PASSWORD=change-me-local-only
DB_SCHEMA=linux_lab
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=30m

# MinIO (access/secret keys are also the MinIO root credentials in Compose)
MINIO_ENDPOINT=192.168.3.111:9100
MINIO_ACCESS_KEY=linuxlab
MINIO_SECRET_KEY=change-me-local-only
MINIO_BUCKET=linux-lab
MINIO_USE_SSL=false
MINIO_API_HOST_PORT=9100
MINIO_CONSOLE_HOST_PORT=9101

# SMTP (Mailpit in development; SMTP_PORT is also the host port in Compose)
SMTP_HOST=192.168.3.111
SMTP_PORT=1125
SMTP_FROM=no-reply@linux-lab.local
SMTP_USERNAME=
SMTP_PASSWORD=
MAILER_WORKERS=2
MAILPIT_UI_HOST_PORT=8125

# Guided voice reader (SPEC-017)
TTS_TIMEOUT=15s
TTS_MAX_CONCURRENT=4

# --- Frontend ---
BACKEND_INTERNAL_URL=http://192.168.3.111:8080
# Hosts allowed to open the dev server from another machine (comma-separated)
FRONTEND_ALLOWED_DEV_ORIGINS=192.168.3.111
